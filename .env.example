# Supabase — preenche com os valores do seu projeto em supabase.com
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only (NUNCA exponha no client). Usado pra criar usuários via service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Web Push (PUSH-A) — par de chaves VAPID (ECDSA P-256). Gere um par novo
# com `node scripts/gerar-vapid.mjs` (script no repo) e cole aqui + no
# `wrangler secret put VAPID_PRIVATE_KEY` em produção. PUBLIC_VAPID_PUBLIC_KEY
# pode ir direto no wrangler.toml/dashboard (não é segredo).
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
