# Supabase — preencha com os valores do SEU projeto em supabase.com.
# PUBLIC_SUPABASE_ANON_KEY aceita a Publishable key atual (sb_publishable_...)
# ou a anon key legada. SUPABASE_SERVICE_ROLE_KEY aceita uma Secret key atual
# (sb_secret_...) ou a service_role legada. Os nomes foram mantidos por
# compatibilidade com o aplicativo.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only (NUNCA exponha no client). O deploy envia como secret do Worker.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Connection string direta ou do pooler, copiada de Connect no Supabase.
# Usada localmente para validar o banco e aplicar a baseline; não vai ao Worker.
SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres

# Cloudflare — token restrito à conta, com permissão de editar Workers Scripts.
# O token valida a conta e autoriza o deploy; não é salvo pelo instalador.
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
CLOUDFLARE_API_TOKEN=
TERRITORY_WORKER_NAME=territorios-congregacao

# Web Push (PUSH-A, OPCIONAL) — par de chaves VAPID (ECDSA P-256). Gere um
# par novo com `node scripts/gerar-vapid.mjs` (script no repo) e cole aqui +
# no painel do seu provedor de deploy (env vars) em produção.
# Lido via $env/dynamic/* (não static) de propósito: faltando, só o Web
# Push real fica desativado — o sino in-app continua funcionando, e o
# build/deploy NÃO quebra (já quebrou uma vez por isso, não repetir).
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
